@echo off
rem Builds SpaceHunter.exe with the C# compiler that ships with Windows. No downloads needed.
rem The fonts in ..\fonts are embedded into the exe (SIL Open Font License, see ..\fonts\OFL.txt).
rem The cleanup items come from cleaners.json (embedded too). The version number comes from ..\VERSION.
setlocal
cd /d "%~dp0"
set /p VER=<..\VERSION
if not exist obj mkdir obj
> obj\Version.cs (
  echo // Generated by build.cmd from ..\VERSION. Do not edit.
  echo using System.Reflection;
  echo [assembly: AssemblyVersion^("%VER%.0"^)]
  echo [assembly: AssemblyFileVersion^("%VER%.0"^)]
  echo [assembly: AssemblyInformationalVersion^("%VER%"^)]
  echo namespace SpaceHunter { static class AppVersion { public const string Text = "%VER%"; } }
)
set RES=
for %%F in (..\fonts\*.ttf) do call set RES=%%RES%% /resource:"%%F",%%~nxF
rem The public half of the release signing key, when present, lets the app check an update before installing it.
set KEY=
if exist ..\update-key\update-key.xml set KEY=/resource:..\update-key\update-key.xml,update-key.xml
set ICON=
if exist assets\SpaceHunter.ico set ICON=/win32icon:assets\SpaceHunter.ico
rem anycpu: one exe that runs natively on 64-bit Intel/AMD and on Windows on ARM (Snapdragon, Surface Pro X: needs
rem .NET Framework 4.8.1, which Windows 11 on ARM has); 32-bit Windows is refused at start (see Program.cs)
"%WINDIR%\Microsoft.NET\Framework64\v4.0.30319\csc.exe" /nologo /target:winexe /platform:anycpu /optimize+ ^
  /win32manifest:app.manifest %ICON% %RES% /resource:cleaners.json,cleaners.json %KEY% ^
  /reference:System.Web.Extensions.dll /out:SpaceHunter.exe src\*.cs obj\Version.cs
if errorlevel 1 (echo BUILD FAILED & exit /b 1)
echo Built %~dp0SpaceHunter.exe (version %VER%)
